# Postgres. Local brew Postgres: include your OS user (Prisma needs it explicitly).
# docker-compose Postgres from the host: postgresql://postgres:postgres@localhost:5433/supertrend
DATABASE_URL=postgresql://youruser@localhost:5432/supertrend

LOG_LEVEL=INFO

# Trade plan sizing
CAPITAL=1000000
RISK_PER_TRADE_PCT=1.0

# Optional Telegram alert after weekly scan
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": ["/scanner/**"]
  },
  "deploy": {
    "startCommand": "sh -c 'python main.py migrate && python main.py weekly --ingest'",
    "cronSchedule": "30 2 * * 6",
    "restartPolicyType": "NEVER"
  }
}

{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": ["/scanner/**"]
  },
  "deploy": {
    "startCommand": "sh -c 'python main.py migrate && python main.py daily'",
    "cronSchedule": "15 13 * * 1-5",
    "restartPolicyType": "NEVER"
  }
}
